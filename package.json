      "import": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "jest": "^30.4.2",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
